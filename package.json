{
	"name": "remove-bg-cli",
	"description": "Remove image backgrounds with remove.bg using the command line",
	"repository": "https://github.com/remove-bg/remove-bg-cli",
	"author": "Kaleido AI GmbH",
	"email": "hello@kaleido.ai",
	"private": true,
	"version": "2.0.3",
	"engines": {
		"node": "24.22.1"
	},
	"bin": "cli.js",
	"scripts": {
		"test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
		"test:coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
		"build": "pkg package.json -o dist/removebg -t host"
	},
	"dependencies": {
		"ag-psd": "^33.0.0",
		"better-queue": "^3.8.12",
		"canvas": "^3.2.3",
		"canvas-exif-orientation": "^0.4.0",
		"cli-progress": "^3.12.0",
		"command-line-args": "^6.0.2",
		"command-line-usage": "^7.0.4",
		"glob": "^13.0.6",
		"jszip": "^3.10.2",
		"png-dpi-reader-writer": "^0.2.4",
		"prompts": "^2.4.2",
		"superagent": "^10.4.1"
	},
	"devDependencies": {
		"@yao-pkg/pkg": "^6.24.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"nock": "^15.0.5"
	},
	"pkg": {
		"scripts": "cli.js",
		"assets": [
			"node_modules/canvas/build/Release/**"
		]
	},
	"allowScripts": {
		"canvas": true
	}
}
